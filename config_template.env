# Saheli App - API Keys Configuration Template
# Copy this file as ".env" and add your real API keys

# Flask Secret Key (Keep this secret!)
SECRET_KEY=your-secret-key-change-this-in-production

# 🗺️ Google Maps & Places API
# Get from: https://console.cloud.google.com/
# Enable: Maps JavaScript API, Places API, Geolocation API
GOOGLE_MAPS_API_KEY=

# 🌤️ OpenWeatherMap API (Free tier: 1000 calls/day)
# Get from: https://openweathermap.org/api
# Free tier includes current weather, sunrise/sunset
OPENWEATHER_API_KEY=

# 📍 IPGeolocation API (Alternative for IP-based location)
# Get from: https://app.ipgeolocation.io/
IPGEOLOCATION_API_KEY=

# 📧 Email Configuration (for SOS Email alerts)
# Use Gmail: Enable "App Passwords" in Google Account settings
# Or use any SMTP service (Gmail, Outlook, SendGrid, etc.)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# ✉️ Email API Configuration (Recommended when SMTP ports are blocked)
# Brevo (Sendinblue) Transactional Email API (works over HTTPS/443)
# 1) Create Brevo account
# 2) Create API key
# 3) Verify sender email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Saheli

# 📱 Twilio SMS Configuration (for SOS SMS alerts)
# Get FREE trial account at: https://www.twilio.com/try-twilio
# Free trial: $15 credit, can send ~500 SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 🚨 Optional: Government Data APIs (Require approval)
NCRB_API_KEY=
DATA_GOV_API_KEY=

# Database Configuration
DATABASE_URL=sqlite:///saheli.db

